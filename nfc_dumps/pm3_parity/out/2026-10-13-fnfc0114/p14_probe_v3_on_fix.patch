+static void p14_done(uint32_t kind, uint32_t idx, uint32_t val) {
+    if(!p14_cap_on) return;
+    p14_cap_on = false;
+    p14_kind = kind;
+    p14_fail_idx = idx;
+    p14_fail_val = val;
+    p14_frames++;
+    p14_cap_busy = true;
+}
+void iso15693_parser_probe_timing(uint32_t rx_end_cyc, uint32_t dma_cyc, uint32_t len) {
+    static uint32_t n = 0;
