+            probe_tx_enter_cyc - t0,
+            probe_prepared_cyc - t0,
+            probe_fdt_cyc - t0,
+            digital_sequence_probe_tx_start_cyc - t0,
+            digital_sequence_probe_dma_start_cyc - t0,
+            probe_fdt_running,
+            (digital_sequence_probe_dma_start_cyc - probe_fdt_cyc) / 64);
+#ifdef NFC_LISTENER_TX_LATENCY_PROBE_V3
+        FURI_LOG_I(
+            TAG,
+            "[PROBE3] %uB rx=%lu copy=%lu run=%lu crc=%lu handler=%lu send=%lu crc_app=%lu tx_enter=%lu",
+            (unsigned)(tx_bits / 8),
+            nfc_probe_handler_cyc[0] - t0,
+            nfc_probe_handler_cyc[1] - t0,
+            nfc_probe_handler_cyc[2] - t0,
+            nfc_probe_handler_cyc[3] - t0,
+            nfc_probe_handler_cyc[4] - t0,
+            nfc_probe_handler_cyc[5] - t0,
+            nfc_probe_handler_cyc[6] - t0,
+            probe_tx_enter_cyc - t0);
+#endif
+#endif
     } while(false);
 
     return ret;
