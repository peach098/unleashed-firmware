FNFC-01.2 latency probe v2 (temporary, NOT for commit). Superset of latency_probe.patch.
Rebased onto FNFC-01.3 (same stamps; context updated). Apply on top of FNFC-01.3:
  git apply nfc_dumps/pm3_parity/out/2026-10-11-fnfc013/latency_probe_v2_rebased.patch
"after":  ./fbt DEBUG=0 --extra-define=NFC_LISTENER_TX_LATENCY_PROBE flash_usb_full
"before": ./fbt DEBUG=0 --extra-define=NFC_LISTENER_TX_LATENCY_PROBE --extra-define=NFC_LISTENER_TX_LATENCY_PROBE_NO_PREPARE flash_usb_full
Output (Info level, CLI `log info`), one line per listener TX, DWT cycles @64MHz relative to RxEnd
(RxEnd = nfc worker got FuriHalNfcEventRxEnd and started the FDT timer):
  [PROBE] <N>B eof2rx= tx_enter= prepared= fdt_end= seq_tx= dma= (fdt_after_prep=) us:dma-fdt=
  eof2rx  = cycles from EOF seen in the iso15693 parser ISR to RxEnd (thread wakeup + parser_run)
  tx_enter= nfc_listener_tx() entry (=> handler / protocol processing time)
  prepared= after furi_hal_nfc_listener_tx_prepare (== tx_enter in NO_PREPARE)
  fdt_end = FDT busy-wait finished
  seq_tx  = digital_sequence_transmit() entry (encode done; in NO_PREPARE this includes the encode)
  dma     = first DMA started (after GPIO init + ring-buffer prefill)
Remove with: git apply -R .../latency_probe_v2.patch

diff --git a/lib/digital_signal/digital_sequence.c b/lib/digital_signal/digital_sequence.c
index 2f4a355f5..4d9a9818b 100644
--- a/lib/digital_signal/digital_sequence.c
+++ b/lib/digital_signal/digital_sequence.c
@@ -195,8 +195,18 @@ void digital_sequence_set_prefill_size(DigitalSequence* sequence, uint32_t prefi
     sequence->prefill_size = MIN(prefill_size, DIGITAL_SEQUENCE_RING_BUFFER_PREFILL_SIZE_MAX);
 }
 
+#ifdef NFC_LISTENER_TX_LATENCY_PROBE
+// Latency probe (FNFC-01.2): DWT->CYCCNT at the moment the first DMA transfer is started
+volatile uint32_t digital_sequence_probe_dma_start_cyc = 0;
+// v2: DWT->CYCCNT at digital_sequence_transmit() entry (encode done, before GPIO init + DMA prefill)
+volatile uint32_t digital_sequence_probe_tx_start_cyc = 0;
+#endif
+
 static inline void digital_sequence_start_dma(DigitalSequence* sequence) {
     furi_assert(sequence);
+#ifdef NFC_LISTENER_TX_LATENCY_PROBE
+    digital_sequence_probe_dma_start_cyc = DWT->CYCCNT;
+#endif
 
     LL_DMA_Init(DMA1, LL_DMA_CHANNEL_1, &sequence->dma_config_gpio);
     LL_DMA_Init(DMA1, LL_DMA_CHANNEL_2, &sequence->dma_config_timer);
@@ -349,6 +359,9 @@ void digital_sequence_transmit(DigitalSequence* sequence) {
     furi_check(sequence->size);
     furi_check(sequence->state == DigitalSequenceStateIdle);
 
+#ifdef NFC_LISTENER_TX_LATENCY_PROBE
+    digital_sequence_probe_tx_start_cyc = DWT->CYCCNT;
+#endif
     FURI_CRITICAL_ENTER();
 
     furi_hal_gpio_init(sequence->gpio, GpioModeOutputPushPull, GpioPullNo, GpioSpeedVeryHigh);
