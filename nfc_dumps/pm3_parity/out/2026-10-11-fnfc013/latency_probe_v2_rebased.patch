             nfc_event.type = NfcEventTypeRxEnd;
             furi_hal_nfc_listener_rx(
@@ -348,22 +363,52 @@ NfcError nfc_listener_tx(Nfc* instance, const BitBuffer* tx_buffer) {
     const size_t tx_bits = bit_buffer_get_size(tx_buffer);
 
     do {
+#ifdef NFC_LISTENER_TX_LATENCY_PROBE
+        const uint32_t probe_tx_enter_cyc = DWT->CYCCNT;
+#endif
         // Do the length-dependent frame preparation while the FDT timer is still running
+#ifndef NFC_LISTENER_TX_LATENCY_PROBE_NO_PREPARE
         FuriHalNfcError error = furi_hal_nfc_listener_tx_prepare(tx_data, tx_bits);
         if(error != FuriHalNfcErrorNone) {
             FURI_LOG_D(TAG, "Failed in listener TX prepare");
             ret = nfc_process_hal_error(error);
             break;
         }
+#else
+        FuriHalNfcError error = FuriHalNfcErrorNone;
+#endif
+#ifdef NFC_LISTENER_TX_LATENCY_PROBE
+        const uint32_t probe_prepared_cyc = DWT->CYCCNT;
+        const bool probe_fdt_running = furi_hal_nfc_timer_block_tx_is_running();
+#endif
 
         while(furi_hal_nfc_timer_block_tx_is_running()) {
         }
+#ifdef NFC_LISTENER_TX_LATENCY_PROBE
+        const uint32_t probe_fdt_cyc = DWT->CYCCNT;
+#endif
 
         error = furi_hal_nfc_listener_tx(tx_data, tx_bits);
         if(error != FuriHalNfcErrorNone) {
             FURI_LOG_D(TAG, "Failed in listener TX");
             ret = nfc_process_hal_error(error);
         }
+#ifdef NFC_LISTENER_TX_LATENCY_PROBE
+        // FURI_LOG_I, not _D: debug logs are compiled out of release builds
+        const uint32_t t0 = nfc_probe_rx_end_cyc;
+        FURI_LOG_I(
+            TAG,
+            "[PROBE] %uB eof2rx=%lu tx_enter=%lu prepared=%lu fdt_end=%lu seq_tx=%lu dma=%lu (fdt_after_prep=%d) us:dma-fdt=%lu",
+            (unsigned)(tx_bits / 8),
+            t0 - iso15693_parser_probe_eof_cyc,
+            probe_tx_enter_cyc - t0,
+            probe_prepared_cyc - t0,
+            probe_fdt_cyc - t0,
+            digital_sequence_probe_tx_start_cyc - t0,
+            digital_sequence_probe_dma_start_cyc - t0,
+            probe_fdt_running,
+            (digital_sequence_probe_dma_start_cyc - probe_fdt_cyc) / 64);
+#endif
     } while(false);
 
     return ret;
